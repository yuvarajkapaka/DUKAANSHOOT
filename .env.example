# ---------------------------------------------------------------------------
# DukaanShoot environment variables.
# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
#
# ZERO-CONFIG DEMO: you can leave EVERYTHING empty. The app then runs with
#   - "Try Demo" login (data saved on the phone),
#   - free demo photos (MockProvider),
#   - a simulated test-mode payment screen.
# ---------------------------------------------------------------------------

# Demo mode (default: true). Keeps payments in TEST mode only, shows "Demo" badges,
# and falls back to demo photos automatically if the real AI fails or runs out of credits.
DEMO_MODE=true

# Secret used to sign simulated payment orders. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ----------------------------------------------------------------- AI (try-on)
# "mock" (default, free) or "real". "real" is used only if FASHN_API_KEY is also set.
TRYON_PROVIDER=mock
# FASHN API key (https://app.fashn.ai/api). Server-only, never sent to the browser.
FASHN_API_KEY=

# --------------------------------------------- Supabase (Google / email login)
# Optional. Without these only "Try Demo" login is shown.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed for credits, refunds and payments on real accounts. NEVER expose this.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Razorpay
# Optional. Without keys a simulated test checkout is shown.
# While DEMO_MODE=true only TEST keys (rzp_test_...) are accepted.
# Razorpay Dashboard → Settings → API Keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → URL https://<your-app>/api/payments/webhook
# events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=

# Credit packs (optional). Prices in paise.
# CREDIT_PACKS=[{"id":"p10","credits":10,"pricePaise":4900},{"id":"p50","credits":50,"pricePaise":19900,"tag":"popular"},{"id":"p150","credits":150,"pricePaise":49900,"tag":"best"}]

# ------------------------------------------------- Two-phone demo (Supabase)
# Shared demo accounts behind "Demo as Seller" / "Demo as Buyer" when Supabase is on.
# Create them (plus the sample shops and products) with:  npm run seed:supabase
# Without Supabase, the demo buttons create on-device accounts instead (no setup).
DEMO_SELLER_EMAIL=
DEMO_SELLER_PASSWORD=
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
